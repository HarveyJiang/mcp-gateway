{
  "name": "mcp-gateway",
  "main": "dist/index.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "PublicMCP", "class_name": "PublicMCP" },
      { "name": "PrivateMCP", "class_name": "PrivateMCP" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PublicMCP", "PrivateMCP"] }
  ],
  "observability": {
    "enabled": true
  }
}